[Unit]
Description=Restrict private cluster ports before Docker publishes them
Before=docker.service pmcluster.service
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/pmcluster/private-ports.nft
ExecReload=/usr/sbin/nft -f /etc/pmcluster/private-ports.nft

[Install]
WantedBy=multi-user.target
